# Flask Environment (development, testing, production)
FLASK_ENV=development
SECRET_KEY=generate-a-secure-random-key-here

# Persistent storage
DATABASE_PATH=youtube_curator_dev.db

# Encryption key for tokens (must be a valid Fernet key in base64, 32 bytes)
# You can generate one via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=K3V3WVhFdmh3Skl2eFhDWTFzTkpxUWx6T0RJM05EUTU=

# Google OAuth 2.0 Credentials
OWNER_GOOGLE_EMAIL=propietario@gmail.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/callback

# Classifier Thresholds
CLASSIFY_AUTO_THRESHOLD=0.85
CLASSIFY_SUGGEST_THRESHOLD=0.55

# Discovery configuration
DISCOVERY_BATCH_SIZE=8
DISCOVERY_MIX_RELATED=5
DISCOVERY_MIX_ADJACENT=2
DISCOVERY_MIX_EXPLORATORY=1
DISCOVERY_MAX_VIDEOS_PER_CHANNEL=2

DISCOVERY_MAX_SEARCHES_PER_REFRESH=10
DISCOVERY_MAX_SEARCHES_PER_CATEGORY=2
DISCOVERY_RESULTS_PER_SEARCH=25

DISCOVERY_SIGNAL_WINDOW_DAYS=90
DISCOVERY_MAX_SEARCH_AGE_DAYS=180
DISCOVERY_SUGGEST_CHANNEL_THRESHOLD_VIDEOS=2

DISCOVERY_MIN_SCORE_RELATED=55.0
DISCOVERY_MIN_SCORE_ADJACENT=45.0
DISCOVERY_MIN_SCORE_EXPLORATORY=35.0

DISCOVERY_REGION_CODE=AR
DISCOVERY_RELEVANCE_LANGUAGE=es
