[Unit]
Description=YouTube Curator staging web application
After=network.target

[Service]
Type=simple
User=youtube-curator
Group=youtube-curator
WorkingDirectory=/opt/youtube-wrapper/staging
EnvironmentFile=/var/lib/youtube-curator-staging/.env
ExecStart=/opt/youtube-wrapper/staging/.venv/bin/gunicorn --no-control-socket --workers 1 --bind 127.0.0.1:8031 --access-logfile - --error-logfile - "app:create_app()"
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/youtube-curator-staging
RestrictSUIDSGID=true
MemoryMax=512M
CPUQuota=100%
TasksMax=128

[Install]
WantedBy=multi-user.target
