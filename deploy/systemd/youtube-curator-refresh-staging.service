[Unit]
Description=Enqueue YouTube Curator staging content refresh
After=youtube-curator-worker-staging.service
Requires=youtube-curator-worker-staging.service

[Service]
Type=oneshot
User=youtube-curator
Group=youtube-curator
WorkingDirectory=/opt/youtube-wrapper/staging
EnvironmentFile=/var/lib/youtube-curator-staging/.env
Environment=PYTHONPATH=/opt/youtube-wrapper/staging
ExecStart=/opt/youtube-wrapper/staging/.venv/bin/python /opt/youtube-wrapper/staging/scripts/enqueue_refresh.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/youtube-curator-staging
RestrictSUIDSGID=true
MemoryMax=256M
CPUQuota=50%
TasksMax=64
