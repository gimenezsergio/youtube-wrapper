# =========================================================
# Configuración de Producción para API YouTube Wrapper / Curator
# =========================================================

# 1. Modo de ejecución
FLASK_ENV=production

# 2. Clave secreta de Flask (Generar una cadena aleatoria segura)
# Ejemplo para generar: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-por-una-clave-secreta-aleatoria-y-segura

# 3. Base de Datos SQLite (Ruta absoluta o relativa persistente en el servidor)
DATABASE_PATH=youtube_curator_prod.db

# 4. Clave de cifrado Fernet para almacenar tokens de OAuth (32 bytes base64)
# OBLIGATORIO cambiar en producción. Para generar una nueva:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=generar-clave-fernet-base64-aqui

# 5. Propietario de la cuenta de Google
OWNER_GOOGLE_EMAIL=tu-email-de-propietario@gmail.com

# 6. Credenciales de Google OAuth 2.0 (Obtenidas de Google Cloud Console)
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-google-client-secret

# IMPORTANTE: Esta URI debe coincidir EXACTAMENTE con la configurada en Google Cloud Console -> Authorized Redirect URIs
GOOGLE_REDIRECT_URI=https://tu-servidor-api.com/api/v1/auth/callback

# 7. (Opcional) Motor LLM para temas adyacentes de descubrimiento (gemini u ollama)
LLM_PROVIDER=gemini
GEMINI_API_KEY=tu-gemini-api-key-aqui

# Configuración regional
DISCOVERY_REGION_CODE=AR
DISCOVERY_RELEVANCE_LANGUAGE=es
